{
  "format": "second-chance-adventure-stage",
  "version": 1,
  "id": "stage-bc934cef-c173-4cc9-8e1b-f2985b6aa6de",
  "title": "데이터 속으로",
  "subtitle": "Inside of dead body",
  "mapId": "classic",
  "backgroundAssetId": "upload:2faeafb2-d4d3-4503-8653-d0802233428e",
  "fallBounds": {
    "left": 62,
